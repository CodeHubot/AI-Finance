# LLM 配置（选择其中一个）
LLM_PROVIDER=openai          # openai | deepseek | tongyi

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（兼容 OpenAI SDK）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（兼容 OpenAI SDK）
TONGYI_API_KEY=sk-xxx
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TONGYI_MODEL=qwen-plus

# 前端 → 后端代理配置
# Docker 部署时无需修改（docker-compose 已自动设置 BACKEND_URL=http://backend:8000）
# 本地开发（非 Docker）时，若后端不在默认 8000 端口可在此指定
BACKEND_URL=http://localhost:8000

# NEXT_PUBLIC_API_BASE_URL 无需设置
# Docker 构建时已置空，浏览器请求通过 Next.js rewrites 代理到 BACKEND_URL
# NEXT_PUBLIC_API_BASE_URL=
